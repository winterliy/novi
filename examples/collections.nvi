import {novi} from {novi};

vari names : list = list();
names.append('Ada');
names.append('Grace');
console.print(names[0]:string);
console.print(names.contains('Grace'):string);
console.print(names.remove('Ada'):string);
console.print('Novi'[1]:string);
console.print('안녕'.length():string);

let point : tuple = tuple(3, 5);
console.print(point[0]:string);
console.print(point.length():string);
foreach (coordinate in point) {
    console.print(coordinate:string);
}

foreach (name in names) {
    console.print(name:string);
}

vari metadata : dictionary = dictionary();
metadata['version'] = '1.0';
console.print(metadata.contains('version'):string);
console.print(metadata.length():string);
console.print(metadata.remove('version'):string);

vari tags : set = set();
tags.add('compiler');
tags.add('compiler');
tags.add('runtime');
console.print(tags.length());
console.print(tags.remove('compiler'):string);

vari tasks : queue = queue();
tasks.enqueue('parse');
tasks.enqueue('compile');
console.print(tasks.peek():string);
console.print(tasks.dequeue():string);
